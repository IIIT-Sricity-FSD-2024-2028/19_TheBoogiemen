# Copy this file to `.env` in the same directory (back-end/.env) and fill it in.
# `.env` is gitignored — never commit real secrets.

# ── Required ─────────────────────────────────────────────────────────────────
# Signing key for JWT access tokens. Minimum 32 characters.
# The server refuses to start if this is missing, too short, or left as-is.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-long-random-string

# ── Optional ─────────────────────────────────────────────────────────────────
# Access token lifetime. Accepts any `ms` duration string (e.g. 30m, 2h, 7d).
JWT_EXPIRES_IN=2h

# bcrypt cost factor. Higher is slower and stronger. Allowed range: 10-15.
BCRYPT_ROUNDS=12

# Set to "production" to disable the /mock-data endpoints.
NODE_ENV=development

# Logging verbosity: trace | debug | info | warn | error | fatal
# Defaults to "debug" in development and "info" in production.
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# Which store backs the app: "memory" (data/mock-db.json) or "postgres".
# Defaults to memory so the app runs without a database.
DATA_STORE=memory

# Aiven connection string. Contains the password — treat it like JWT_SECRET.
# DATABASE_URL=postgres://avnadmin:<password>@<service>.aivencloud.com:<port>/barelypassing_dev?sslmode=verify-full

# Path to the Aiven CA certificate (download ca.pem from the service overview).
# Required for any non-local DATABASE_URL. Never disable verification instead.
# PGSSLROOTCERT=./certs/ca.pem

# Aiven's free tier allows 20 connections total with no PgBouncer. Budget this
# across every developer and deployed instance.
DB_POOL_MAX=5

# ── CORS ─────────────────────────────────────────────────────────────────────
# The frontend is served from the same origin as the API, so cross-origin access
# is DISABLED unless this names allowed origins (comma-separated).
# Leave empty in normal deployments. Never use a wildcard: the session cookie is
# sent with credentials, so a reflected origin lets any site read responses.
# CORS_ORIGIN=http://localhost:3000
